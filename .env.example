# Development only. Keep .env and production credentials out of Git.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=django-insecure-kt-local-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
POSTGRES_DB=kho_tri_thuc
