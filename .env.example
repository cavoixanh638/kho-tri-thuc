# Development only. Keep .env and production credentials out of Git.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=django-insecure-kt-local-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
POSTGRES_DB=kho_tri_thuc
POSTGRES_USER=kho_tri_thuc
POSTGRES_PASSWORD=kt-local-development-only
API_PORT=8000
WEB_PORT=5173

# Optional Google Drive OAuth. Store real values only in your private runtime configuration.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:5173/api/v1/integrations/drive/callback
GOOGLE_DRIVE_TOKEN_KEY=

# Optional development-only manual suggestion review. No AI provider or external call.
SUGGESTION_REVIEW_POC_ENABLED=0

# Model list refresh is read-only and only active with the server-side key.
# Obtain the key from your own AI Studio project. Never commit real API keys.
GEMINI_API_KEY=
# Discovery alone makes no image or paid model calls.
GEMINI_OCR_ENABLED=0
GEMINI_ALLOW_PREMIUM_MODELS=0
GEMINI_MAX_LOCAL_REQUESTS_PER_DAY=80
